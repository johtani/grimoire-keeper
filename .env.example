# BWS_ACCESS_TOKEN は ~/.config/bws.env に保存してください（このファイルには記載不要）
# mkdir -p ~/.config && echo 'BWS_ACCESS_TOKEN=your-token' > ~/.config/bws.env && chmod 600 ~/.config/bws.env
# 詳細: docs/development.md

# 以下のシークレットはBitwarden Secrets Managerに登録してください
# - OPENAI_API_KEY
# - JINA_API_KEY
# - SLACK_BOT_TOKEN
# - SLACK_SIGNING_SECRET
# - SLACK_APP_TOKEN
# クラウドLLM (Gemini等) を使う場合は追加:
# - LLM_API_KEY  (要約LLM用。クラウド構成では実APIキー、ローカル構成ではdummy可)

# Services（非秘密の設定値）
BACKEND_API_URL=http://api:8000
WEAVIATE_HOST=localhost
# ホスト側から接続する場合は 8089 (docker-compose.prod.yml のホスト公開ポート)
# Docker コンテナ内からの通信は 8080 (docker-compose で自動上書き済み)
WEAVIATE_PORT=8089
WEAVIATE_EMBEDDING_PROVIDER=text2vec-openai
WEAVIATE_EMBEDDING_MODEL=text-embedding-ada-002
WEAVIATE_EMBEDDING_DIMENSIONS=1536
DATABASE_PATH=./grimoire.db

# LLM設定（環境変数で切り替え可能）
# ローカルLLM (llama-swap + llama.cpp):
LLM_MODEL=openai/qwen3-35b
# ホスト上で worker を直接実行するときの接続先
LLM_API_BASE=http://localhost:8080/v1
# Docker Compose の worker からホスト上の LLM へ接続するときの接続先
# クラウドLLMでは空にする (DOCKER_LLM_API_BASE=)
DOCKER_LLM_API_BASE=http://host.docker.internal:8080/v1
LLM_API_KEY=dummy
# 入力トークン数 + 最大出力トークン数がコンテキスト上限内になるよう制御
LLM_CONTEXT_WINDOW=32768
LLM_MAX_OUTPUT_TOKENS=1024
# 長文の部分要約で同時に送信する最大リクエスト数
LLM_SUMMARY_CONCURRENCY=3
# 1回のLLM呼び出しに対するSDKレベルのtimeout/retry
LLM_TIMEOUT=60
LLM_RETRY_ATTEMPTS=3
LLM_RETRY_BACKOFF_BASE=1
LLM_RETRY_BACKOFF_MAX=10
LLM_RETRY_JITTER=0.5
LLM_RETRY_AFTER_MAX=30

# Jina ReaderのHTTP timeout/retry
JINA_CONNECT_TIMEOUT=5
JINA_READ_TIMEOUT=60
JINA_WRITE_TIMEOUT=10
JINA_POOL_TIMEOUT=5
JINA_RETRY_ATTEMPTS=3
JINA_RETRY_BACKOFF_BASE=1
JINA_RETRY_BACKOFF_MAX=10
JINA_RETRY_JITTER=0.5
JINA_RETRY_AFTER_MAX=30

# Weaviateクライアントのtimeout/retry
WEAVIATE_CONNECT_TIMEOUT=5
WEAVIATE_QUERY_TIMEOUT=30
WEAVIATE_INSERT_TIMEOUT=90
WEAVIATE_RETRY_ATTEMPTS=3
WEAVIATE_RETRY_BACKOFF_BASE=0.5
WEAVIATE_RETRY_BACKOFF_MAX=5
WEAVIATE_RETRY_JITTER=0.25
WEAVIATE_RETRY_AFTER_MAX=10
WEAVIATE_DELETE_POLL_ATTEMPTS=10
WEAVIATE_DELETE_POLL_INTERVAL=0.1
# クラウドLLM (Gemini) に切り替える場合:
# LLM_MODEL=gemini/gemini-2.5-flash-lite
# LLM_API_KEY=<provider-api-key>  # GRIMOIRE_KEEPER_LLM_API_KEYとしてBWSから注入
# LLM_API_BASE=  # 空にする
# DOCKER_LLM_API_BASE=  # Compose の worker でも空にする

# OpenTelemetry
# 未設定時は exporter と自動計装を無効化します。有効化する場合のみ設定してください。
# OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4317
OTEL_RESOURCE_ATTRIBUTES=service.namespace=grimoire-keeper
